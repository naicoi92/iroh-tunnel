# Role-only image for `iroh-tunnel-serve` (issue #94), built by the `release` workflow.
# Same layout as `Dockerfile.release` (read its header for
# how the prebuilt binary is staged), but it ships ONLY the standalone
# `iroh-tunnel-serve` executable, so the image runs without any other binary.

# syntax=docker/dockerfile:1
FROM gcr.io/distroless/cc-debian12

ARG TARGETPLATFORM

ENV HOME=/tmp
# `update` reads this to point at image redeployment instead of replacing files (#96).
ENV IROH_TUNNEL_CONTAINER=1

COPY $TARGETPLATFORM/iroh-tunnel-serve /usr/local/bin/iroh-tunnel-serve

ENTRYPOINT ["iroh-tunnel-serve"]
